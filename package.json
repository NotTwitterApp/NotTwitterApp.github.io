{
  "name": "twitter-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --require ./scripts/buffer-compat.js ./node_modules/next/dist/bin/next dev",
    "prebuild": "node scripts/write-atproto-client-metadata.mjs",
    "build": "next build",
    "export": "NEXT_STATIC_EXPORT=true npm run build",
    "start": "next start",
    "format": "prettier --check .",
    "lint": "next lint",
    "test": "jest --watch",
    "test:ci": "jest --ci",
    "prepare": "husky"
  },
  "dependencies": {
    "@atproto/api": "^0.20.44",
    "@atproto/common-web": "^0.5.12",
    "@atproto/lexicon": "^0.7.14",
    "@atproto/oauth-client-browser": "^0.5.7",
    "@atproto/syntax": "^0.7.6",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@twemoji/api": "^17.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "hls.js": "^1.7.3",
    "next": "^16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.6.0",
    "react-textarea-autosize": "^8.5.9",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.104.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  },
  "engines": {
    "node": "26.x"
  }
}
